{
  "title": "Full-Stack Infra Dashboard",
  "uid": "fullstack_infra",
  "templating": {
    "list": [
      {"name":"datasource","type":"datasource","query":"prometheus","label":"Data Source"},
      {"name":"job","type":"query","datasource":"${datasource}","query":"label_values(prometheus_build_info, job)"},
      {"name":"node","type":"query","datasource":"${datasource}","query":"label_values(node_uname_info, instance)"},
      {"name":"container","type":"query","datasource":"${datasource}","query":"label_values(container_memory_usage_bytes, container)"}
    ]
  },
  "panels": [
    {
      "title": "--- Prometheus Self-Monitor ---",
      "type": "row",
      "gridPos": {"x":0,"y":0,"w":24,"h":1}
    },
    {
      "id":1,
      "title":"Samples Appended",
      "type":"timeseries",
      "datasource":{"uid":"${datasource}"},
      "gridPos":{"x":0,"y":1,"w":12,"h":7},
      "targets":[{"expr":"sum(irate(prometheus_tsdb_head_samples_appended_total{job=\"${job}\"}[$__rate_interval]))","legendFormat":"Samples/sec"}]
    },
    {
      "id":2,
      "title":"WAL Corruptions",
      "type":"stat",
      "datasource":{"uid":"${datasource}"},
      "gridPos":{"x":12,"y":1,"w":12,"h":7},
      "targets":[{"expr":"sum(prometheus_tsdb_wal_corruptions_total{job=\"${job}\"})","legendFormat":"Corruptions"}],
      "colorMode":"value",
      "thresholds":[{"value":0,"color":"green"},{"value":1,"color":"red"}]
    },
    {
      "title": "--- Node Exporter ---",
      "type": "row",
      "gridPos": {"x":0,"y":8,"w":24,"h":1}
    },
    {
      "id":3,
      "title":"Node CPU Usage",
      "type":"timeseries",
      "datasource":{"uid":"${datasource}"},
      "gridPos":{"x":0,"y":9,"w":12,"h":6},
      "targets":[{"expr":"100 - (avg by(instance)(rate(node_cpu_seconds_total{mode='idle',instance='${node}'}[1m])) * 100)","legendFormat":"{{instance}} CPU%"}]
    },
    {
      "id":4,
      "title":"Node Memory Usage",
      "type":"timeseries",
      "datasource":{"uid":"${datasource}"},
      "gridPos":{"x":12,"y":9,"w":12,"h":6},
      "targets":[{"expr":" ( 1 - ( node_memory_MemAvailable_bytes{instance='${node}'} / node_memory_MemTotal_bytes{instance='${node}'} ) ) * 100","legendFormat":"{{instance}} Mem%"}]
    },
    {
      "title": "--- Docker Containers (cAdvisor) ---",
      "type": "row",
      "gridPos": {"x":0,"y":15,"w":24,"h":1}
    },
    {
      "id":5,
      "title":"Container CPU Usage",
      "type":"timeseries",
      "datasource":{"uid":"${datasource}"},
      "gridPos":{"x":0,"y":16,"w":12,"h":6},
      "targets":[{"expr":"rate(container_cpu_usage_seconds_total{container='${container}'}[1m])*100","legendFormat":"{{container}} CPU%"}]
    },
    {
      "id":6,
      "title":"Container Memory Usage",
      "type":"timeseries",
      "datasource":{"uid":"${datasource}"},
      "gridPos":{"x":12,"y":16,"w":12,"h":6},
      "targets":[{"expr":"container_memory_usage_bytes{container='${container}'} / 1024 / 1024","legendFormat":"{{container}} MB"}]
    },
    {
      "id":7,
      "title":"Container Restart Count",
      "type":"timeseries",
      "datasource":{"uid":"${datasource}"},
      "gridPos":{"x":12,"y":16,"w":12,"h":6},
      "targets":[{"expr":"rate(container_network_receive_bytes_total[1m]) / 1024 / 1024","legendFormat":"{{container}} MB"}]
    },
    {
      "id":8,
      "title":"Container Restart Count",
      "type":"timeseries",
      "datasource":{"uid":"${datasource}"},
      "gridPos":{"x":12,"y":16,"w":12,"h":6},
      "targets":[{"expr":"changes(container_start_time_seconds[1h]) / 24 / 24","legendFormat":"{{container}} MB"}]
    }
  ]
}